{
    "firestore": {
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json"
    },
    "functions": [
        {
            "source": "functions",
            "codebase": "default",
            "predeploy": [
                "node scripts/copy-core-engine.js"
            ],
            "ignore": [
                "node_modules",
                ".git",
                "firebase-debug.log",
                "firebase-debug.*.log"
            ]
        }
    ],
    "hosting": {
        "public": ".",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/.*/**",
            "**/node_modules/**",
            "functions/**",
            "tests/**",
            "test-results/**",
            "playwright-report/**",
            "scripts/**",
            "archive/**",
            "docs/**",
            "assets/rules/**",
            "**/*.md",
            "**/*.log",
            "*.cjs",
            "*.py",
            "package.json",
            "package-lock.json",
            "playwright.config.js",
            "fix-dressyr.js",
            "firestore.rules",
            "firestore.indexes.json",
            "storage.rules",
            "cors.json",
            "sdkconfig.json",
            "seed_test.html",
            "test_pdf.html",
            "test_pdf_error.html"
        ],
        "headers": [
            {
                "source": "**/*.@(js|mjs|css|html|json)",
                "headers": [
                    { "key": "Cache-Control", "value": "no-cache" }
                ]
            }
        ]
    },
    "storage": {
        "rules": "storage.rules"
    },
    "emulators": {
        "auth": { "port": 9099 },
        "firestore": { "port": 8080 },
        "functions": { "port": 5001 },
        "storage": { "port": 9199 }
    }
}