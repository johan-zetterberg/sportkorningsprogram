{
    "firestore": {
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json"
    },
    "functions": [
        {
            "source": "functions",
            "codebase": "default",
            "predeploy": [
                "node scripts/copy-core-engine.js"
            ],
            "ignore": [
                "node_modules",
                ".git",
                "firebase-debug.log",
                "firebase-debug.*.log"
            ]
        }
    ],
    "hosting": {
        "public": ".",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/.*/**",
            "**/node_modules/**",
            "functions/**",
            "tests/**",
            "test-results/**",
            "playwright-report/**",
            "scripts/**",
            "archive/**",
            "docs/**",
            "assets/rules/**",
            "**/*.md",
            "**/*.log",
            "*.cjs",
            "*.py",
            "package.json",
            "package-lock.json",
            "playwright.config.js",
            "fix-dressyr.js",
            "firestore.rules",
            "firestore.indexes.json",
            "storage.rules",
            "cors.json",
            "sdkconfig.json",
            "seed_test.html",
            "test_pdf.html",
            "test_pdf_error.html",
            "pdf.min.js",
            "pdf.worker.min.js",
            "lib/pdfjs/build/*.map",
            "lib/pdfjs/build/pdf.js",
            "lib/pdfjs/build/pdf.min.js",
            "lib/pdfjs/build/pdf.mjs",
            "lib/pdfjs/build/pdf.sandbox*",
            "lib/pdfjs/build/pdf.worker.min.js",
            "lib/pdfjs/build/pdf.worker.mjs",
            "img/maraton-course.png"
        ],
        "headers": [
            {
                "source": "**/*.@(js|mjs|css|html|json)",
                "headers": [
                    { "key": "Cache-Control", "value": "no-cache" }
                ]
            },
            {
                "regex": "^/(.*\\.html)?$",
                "headers": [
                    { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'sha256-6caA9rCirR3PIgksdBPMhmwqsUy7YowTWLK7BaquhBc=' 'sha256-yTg61YszC0prZwcfgnpOhChUIcSVQ1rjG9/lZvBJZ6g=' 'sha256-PaT4R+YElXeyWS2Xl1x7BVeewNmiN1EW0GCbIyOwJHA=' 'sha256-P9Fr/TrDgaKWNR0mOLDienUSk4Wds6xPjN6yNbcjfXg=' https://www.gstatic.com https://unpkg.com https://cdnjs.cloudflare.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; connect-src 'self' https://apis.google.com https://www.google.com https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firebasestorage.googleapis.com https://europe-west1-combined-driving.cloudfunctions.net https://fcmregistrations.googleapis.com https://firebaseinstallations.googleapis.com; worker-src 'self' blob:; frame-src 'self' blob: https://combined-driving.firebaseapp.com https://apis.google.com; manifest-src 'self'; media-src 'self' blob: https://firebasestorage.googleapis.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" }
                ]
            },
            {
                "source": "**",
                "headers": [
                    { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
                    { "key": "X-Content-Type-Options", "value": "nosniff" },
                    { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
                    { "key": "Permissions-Policy", "value": "microphone=(), camera=(), payment=(), usb=()" }
                ]
            }
        ]
    },
    "storage": {
        "rules": "storage.rules"
    },
    "emulators": {
        "auth": { "port": 9099 },
        "firestore": { "port": 8080 },
        "functions": { "port": 5001 },
        "storage": { "port": 9199 }
    }
}