{
    "firestore": {
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json"
    },
    "functions": [
        {
            "source": "functions",
            "codebase": "default",
            "predeploy": [
                "node scripts/copy-core-engine.js"
            ],
            "ignore": [
                "node_modules",
                ".git",
                "firebase-debug.log",
                "firebase-debug.*.log"
            ]
        }
    ],
    "hosting": {
        "public": ".",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/.*/**",
            "**/node_modules/**",
            "functions/**",
            "tests/**",
            "test-results/**",
            "playwright-report/**",
            "scripts/**",
            "archive/**",
            "docs/**",
            "assets/rules/**",
            "**/*.md",
            "**/*.log",
            "*.cjs",
            "*.py",
            "package.json",
            "package-lock.json",
            "playwright.config.js",
            "fix-dressyr.js",
            "firestore.rules",
            "firestore.indexes.json",
            "storage.rules",
            "cors.json",
            "sdkconfig.json",
            "seed_test.html",
            "test_pdf.html",
            "test_pdf_error.html",
            "pdf.min.js",
            "pdf.worker.min.js",
            "lib/pdfjs/build/*.map",
            "lib/pdfjs/build/pdf.js",
            "lib/pdfjs/build/pdf.min.js",
            "lib/pdfjs/build/pdf.mjs",
            "lib/pdfjs/build/pdf.sandbox*",
            "lib/pdfjs/build/pdf.worker.min.js",
            "lib/pdfjs/build/pdf.worker.mjs",
            "img/maraton-course.png"
        ],
        "headers": [
            {
                "source": "**/*.@(js|mjs|css|html|json)",
                "headers": [
                    { "key": "Cache-Control", "value": "no-cache" }
                ]
            },
            {
                "source": "**",
                "headers": [
                    { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" },
                    { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
                    { "key": "X-Content-Type-Options", "value": "nosniff" },
                    { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
                    { "key": "Permissions-Policy", "value": "microphone=(), camera=(), payment=(), usb=()" }
                ]
            }
        ]
    },
    "storage": {
        "rules": "storage.rules"
    },
    "emulators": {
        "auth": { "port": 9099 },
        "firestore": { "port": 8080 },
        "functions": { "port": 5001 },
        "storage": { "port": 9199 }
    }
}