{
  "name": "sportkorningsprogram",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.cjs -i css/tailwind.input.css -o css/tailwind.css --minify",
    "test": "node --test tests/*.test.js",
    "test:rules": "node scripts/run-firestore-rules-tests.mjs",
    "test:smoke": "node scripts/run-smoke-tests.mjs",
    "test:smoke:navigation": "node scripts/run-smoke-tests.mjs -g \"all main pages\"",
    "test:smoke:critical": "node scripts/run-smoke-tests.mjs -g \"critical ui\"",
    "test:smoke:stages": "node scripts/run-smoke-tests.mjs -g \"maraton stages can pause resume reset save and reload state\"",
    "test:smoke:headed": "node scripts/run-smoke-tests.mjs --headed",
    "deploy": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.54.1",
    "firebase": "^11.6.1",
    "tailwindcss": "^3.4.17"
  }
}
