{
  "name": "sportkorningsprogram",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:smoke": "playwright test tests/browser-smoke.spec.js",
    "test:smoke:navigation": "playwright test tests/browser-smoke.spec.js -g \"all main pages\"",
    "test:smoke:critical": "playwright test tests/browser-smoke.spec.js -g \"critical ui\"",
    "test:smoke:headed": "playwright test tests/browser-smoke.spec.js --headed",
    "deploy": "git add . && git commit -m \"Automatisk uppdatering\" && git push && firebase deploy"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1"
  }
}
