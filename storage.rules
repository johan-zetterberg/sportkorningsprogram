rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.superadmin == true ||
        (
          firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) && (
            firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin'] ||
            'superadmin' in (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.roles || []) ||
            'admin' in (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.roles || [])
          )
        )
      );
    }

    // Uploads: a size limit, so a mistake can't fill the bucket
    function isReasonableUpload(maxBytes) {
      return request.resource == null || request.resource.size < maxBytes;
    }

    // Explicit rule for competition assets
    match /competitions/{competitionId}/assets/club-logos/{allPaths=**} {
      allow get: if true;
      allow write: if isAdmin() && isReasonableUpload(5 * 1024 * 1024);
    }

    // Competition documents (maps, PDFs). Read by their link only: listing
    // would reveal documents meant for drivers (the app never lists files)
    match /competitions/{competitionId}/documents/{allPaths=**} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin() && isReasonableUpload(50 * 1024 * 1024);
    }

    // Default catch-all: deny everything outside explicitly public paths.
    match /{allPaths=**} {
      allow read: if false;
      allow write: if false; 
    }
  }
}
