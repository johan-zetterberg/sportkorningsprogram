rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {


    // ---- Roll- & behörighets-hjälpare --------------------------------------

    // Säkrare getUserRole: hanterar saknad users-doc
    function getUserRole() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', null)
        : null;
    }

    // Superadmin via ANTINGEN custom claim (request.auth.token.superadmin == true)
    // ELLER users/{uid} där role == "superadmin" ELLER roles innehåller "superadmin"
    function isSuperAdmin() {
      return (
        (request.auth != null && request.auth.token.get('superadmin', false) == true) ||
        (
          request.auth != null &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'superadmin' ||
            (
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roles', []) != null &&
              'superadmin' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roles', [])
            )
          )
        )
      );
    }

    // Email-based access (roleEmails, a driver's own entry) only for an address
    // the account holder has verified: anyone can register an account with an
    // address that is not theirs, e.g. an official's before the official does.
    function hasVerifiedEmail() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.get('email_verified', false) == true;
    }

    function hasRoleEmailAccess(appId, compId, roleName) {
      let email = hasVerifiedEmail() ? request.auth.token.email.lower() : '__no_email__';
      let roleDoc = /databases/$(database)/documents/artifacts/$(appId)/public/data/competitions/$(compId)/roleEmails/$(email);
      return email != '__no_email__' && exists(roleDoc)
        ? (
          (get(roleDoc).data.get('roles', []) != null && roleName in get(roleDoc).data.get('roles', [])) ||
          get(roleDoc).data.get('role', '') == roleName
        )
        : false;
    }

    // Behörighet till viss tävling i artifacts-trädet:
    // Tillåter superadmin, global admin, skapare (createdBy), eller den som:
    // 1. Finns i admins[] arrayen
    // 2. Finns i privata roleEmails/{email}
    // 3. Finns i /admins/{uid} underkollektionen (använt rätt PIN-kod)
    function canAdminThisArtifactsCompBase(appId, compId) {
      let compPath = /databases/$(database)/documents/artifacts/$(appId)/public/data/competitions/$(compId);
      return request.auth != null
        && exists(compPath)
        && (
          isSuperAdmin() ||
          getUserRole() == 'admin' ||
          get(compPath).data.get('createdBy', '') == request.auth.uid ||
          get(compPath).data.get('ownerId', '') == request.auth.uid ||
          (
            get(compPath).data.get('admins', []) != null &&
            request.auth.uid in get(compPath).data.get('admins', [])
          ) ||
          (
            exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/competitions/$(compId)/admins/$(request.auth.uid)) &&
            (
              get(/databases/$(database)/documents/artifacts/$(appId)/public/data/competitions/$(compId)/admins/$(request.auth.uid)).data.get('role', 'admin') == 'admin' ||
              (
                get(/databases/$(database)/documents/artifacts/$(appId)/public/data/competitions/$(compId)/admins/$(request.auth.uid)).data.get('roles', []) != null &&
                'admin' in get(/databases/$(database)/documents/artifacts/$(appId)/public/data/competitions/$(compId)/admins/$(request.auth.uid)).data.get('roles', [])
              )
            )
          )
        );
    }

    function hasExplicitRoleInComp(appId, compId, roleName) {
      return hasRoleEmailAccess(appId, compId, roleName) ||
        (
          exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/competitions/$(compId)/admins/$(request.auth.uid)) &&
          (
            get(/databases/$(database)/documents/artifacts/$(appId)/public/data/competitions/$(compId)/admins/$(request.auth.uid)).data.get('role', 'admin') == roleName ||
            (
              get(/databases/$(database)/documents/artifacts/$(appId)/public/data/competitions/$(compId)/admins/$(request.auth.uid)).data.get('roles', []) != null &&
              roleName in get(/databases/$(database)/documents/artifacts/$(appId)/public/data/competitions/$(compId)/admins/$(request.auth.uid)).data.get('roles', [])
            )
          )
        );
    }

    function canAdminThisArtifactsComp(appId, compId) {
      return canAdminThisArtifactsCompBase(appId, compId)
        || hasRoleEmailAccess(appId, compId, 'admin');
    }

    // The roles of canReadCompetitionStaffDocs from one look at the account's
    // admins doc and roleEmails doc (no owner/global admin check: callers add
    // canAdminThisArtifactsComp). Cheaper where the expression limit is tight.
    function hasStaffRoleInComp(appId, compId) {
      let staffRoles = ['admin', 'dressage', 'marathon', 'precision', 'speaker', 'vet'];
      let adminPath = /databases/$(database)/documents/artifacts/$(appId)/public/data/competitions/$(compId)/admins/$(request.auth.uid);
      let email = hasVerifiedEmail() ? request.auth.token.email.lower() : '__no_email__';
      let rolePath = /databases/$(database)/documents/artifacts/$(appId)/public/data/competitions/$(compId)/roleEmails/$(email);
      return request.auth != null
        && (
          (exists(adminPath) && (
            get(adminPath).data.get('role', 'admin') in staffRoles
            || (get(adminPath).data.get('roles', []) is list && get(adminPath).data.get('roles', []).hasAny(staffRoles))
          ))
          || (email != '__no_email__' && exists(rolePath) && (
            get(rolePath).data.get('role', '') in staffRoles
            || (get(rolePath).data.get('roles', []) is list && get(rolePath).data.get('roles', []).hasAny(staffRoles))
          ))
        );
    }

    function canReadCompetitionStaffDocs(appId, compId) {
      return request.auth != null
        && (
          // Every competition role (the vet too, a limited role that writes
          // only the vet data) from one look at the admins and roleEmails
          // docs: asking each role in turn ran past the rules' limit of 1000
          // evaluated expressions on a draft competition
          hasStaffRoleInComp(appId, compId) ||
          canAdminThisArtifactsComp(appId, compId)
        );
    }

    // A draft (published: false) is visible only to the competition's staff
    // and admins; everything else is public. Competitions without the field
    // are older ones and count as published. Missing parent competition means
    // orphaned subcollection data and is not publicly readable.
    function isCompetitionVisible(appId, compId) {
      let comp = /databases/$(database)/documents/artifacts/$(appId)/public/data/competitions/$(compId);
      return exists(comp)
        && (
          get(comp).data.get('published', true) != false
          || canReadCompetitionStaffDocs(appId, compId)
        );
    }

    function canFinalizeCompetitionViaApp(appId, compId, roleName) {
      let compPath = /databases/$(database)/documents/artifacts/$(appId)/public/data/competitions/$(compId);
      let adminPath = /databases/$(database)/documents/artifacts/$(appId)/public/data/competitions/$(compId)/admins/$(request.auth.uid);
      let joinedRoles = !exists(adminPath)
        ? []
        : (
          get(adminPath).data.get('roles', []) != null
            ? get(adminPath).data.get('roles', [])
            : [get(adminPath).data.get('role', '')]
        );

      return request.auth != null
        && exists(compPath)
        && isCompetitionOpen(appId, compId)
        && (
          canAdminThisArtifactsComp(appId, compId) ||
          hasRoleEmailAccess(appId, compId, roleName) ||
          (
            exists(adminPath) &&
            (
              get(adminPath).data.get('role', '') == roleName ||
              get(adminPath).data.get('role', '') == 'admin' ||
              (joinedRoles != null && roleName in joinedRoles) ||
              (joinedRoles != null && 'admin' in joinedRoles)
            )
          )
        );
    }

    function canFinalizeCompetition(compId, roleName) {
      return request.auth != null
        && (
          // Superadmins too only while the competition is open: an archived
          // competition is reopened first, like for everyone else
          (isSuperAdmin()
            && isCompetitionOpen('combined-driving', compId)
            && isCompetitionOpen('drivelive', compId)) ||
          canFinalizeCompetitionViaApp('combined-driving', compId, roleName) ||
          canFinalizeCompetitionViaApp('drivelive', compId, roleName)
        );
    }

    // An archived competition (finalizeCompetition sets locked and status
    // 'completed') takes no result writes at all, admins included: an admin
    // reopens it first (reopenCompetition, which is logged)
    function isCompetitionOpen(appId, compId) {
      let comp = /databases/$(database)/documents/artifacts/$(appId)/public/data/competitions/$(compId);
      return !exists(comp)
        || (get(comp).data.get('locked', false) != true && get(comp).data.get('status', '') != 'completed');
    }

    // The driver portal's declaration: not archived and not locked by the secretariat
    function isDeclarationOpen(appId, compId) {
      let meta = /databases/$(database)/documents/artifacts/$(appId)/public/data/competitions/$(compId)/config/competitionMeta;
      return isCompetitionOpen(appId, compId)
        && (!exists(meta) || get(meta).data.get('manualLockdown', false) != true);
    }

    function canWriteResultsAs(appId, compId, roleName) {
      return request.auth != null
        && isCompetitionOpen(appId, compId)
        && (
          canAdminThisArtifactsComp(appId, compId)
          || hasExplicitRoleInComp(appId, compId, roleName)
        );
    }

    // Unlocked before this write (finalizing: result and lock in one batch) or
    // after it (unlocking: lock and result in one batch, so a network error
    // cannot leave an unlocked lock with a result still marked finalized)
    function isPrecisionResultUnlocked(compId, startNo) {
      let finPath = /databases/$(database)/documents/competitions/$(compId)/precisionFinalization/$(startNo);
      return !exists(finPath)
        || get(finPath).data.get('finalized', false) != true
        || (existsAfter(finPath) && getAfter(finPath).data.get('finalized', false) != true);
    }

    function isMarathonResultUnlocked(compId, startNo) {
      let finPath = /databases/$(database)/documents/competitions/$(compId)/marathonFinalization/$(startNo);
      return !exists(finPath)
        || get(finPath).data.get('finalized', false) != true
        || (existsAfter(finPath) && getAfter(finPath).data.get('finalized', false) != true);
    }

    // A finalize/unlock must name a new finalizationLog entry, written in the
    // same batch, for this result and this change (see finalizationService)
    function isLoggedLockChange(compId, discipline, startNo) {
      let logId = request.resource.data.get('lastLogId', '');
      let logPath = /databases/$(database)/documents/competitions/$(compId)/finalizationLog/$(logId);
      let log = getAfter(logPath).data;
      return logId is string && logId.size() > 0
        && (resource == null || resource.data.get('lastLogId', '') != logId)
        && existsAfter(logPath)
        && log.discipline == discipline
        && log.startNumber == startNo
        && log.action == (request.resource.data.get('finalized', false) == true ? 'finalize' : 'unfinalize');
    }

    function isLockNamingLogEntry(compId, discipline, startNo, entryId) {
      let lockPath = /databases/$(database)/documents/competitions/$(compId)/$(discipline + 'Finalization')/$(startNo);
      return existsAfter(lockPath)
        && getAfter(lockPath).data.get('lastLogId', '') == entryId;
    }

    // Pause log (subtracted from every stage time): officials may only add a
    // new open pause or close the open one, as the observer page does. Earlier
    // pauses cannot be changed or removed (the competition's admins can).
    function isPauseEntry(entry) {
      return entry is map
        && entry.keys().hasOnly(['start', 'end', 'durationSec'])
        && entry.get('start', null) is string;
    }

    function isPauseLogAppendOrClose() {
      let before = resource == null ? [] : resource.data.get('pauseLog', []);
      let after = request.resource.data.get('pauseLog', []);
      let n = before.size();
      return after == before
        || (
          // A new pause
          after.size() == n + 1
          && (n == 0 || after[0:n] == before)
          && isPauseEntry(after[n])
          && after[n].get('end', null) == null
        )
        || (
          // The open pause closed
          n > 0
          && after.size() == n
          && (n == 1 || after[0:n - 1] == before[0:n - 1])
          && before[n - 1].get('end', null) == null
          && isPauseEntry(after[n - 1])
          && after[n - 1].start == before[n - 1].start
          && after[n - 1].get('end', null) is string
        );
    }

    function isDressageResultUnlocked(compId, startNo) {
      let finPath = /databases/$(database)/documents/competitions/$(compId)/dressageFinalization/$(startNo);
      return !exists(finPath) ? true : get(finPath).data.get('finalized', false) != true;
    }

    function canSelfServiceEquipage(appId, compId, equipageId) {
      return hasVerifiedEmail()
        && exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/competitions/$(compId)/equipagePrivate/$(equipageId))
        && request.auth.token.email.lower() == get(/databases/$(database)/documents/artifacts/$(appId)/public/data/competitions/$(compId)/equipagePrivate/$(equipageId)).data.get('email', '').lower();
    }

    // Collections under a competition that the public read below must not
    // expose. Each pattern ends in ($|/.*) so it also matches the collection
    // path itself: a list query is checked against that path, so a pattern
    // that requires a document id after the name let anyone list the whole
    // collection while single reads were denied.
    function isSensitiveArtifactsPublicPath(documentPath) {
      let pathStr = string(documentPath);
      let comp = '.*data/competitions/[^/]+/';
      return pathStr.matches(comp + 'config/secrets($|/.*)')
        // All of config: through this catch-all a list of config would return
        // config/secrets (all PINs) too. Single config docs except secrets are
        // readable through the config/{configId} rule (get only)
        || pathStr.matches(comp + 'config($|/.*)')
        || pathStr.matches(comp + 'auditLog($|/.*)')
        || pathStr.matches(comp + 'equipagePrivate($|/.*)')
        || pathStr.matches(comp + 'roleEmails($|/.*)')
        || pathStr.matches(comp + 'judges($|/.*)')
        || pathStr.matches(comp + 'officials($|/.*)')
        || pathStr.matches(comp + 'officialsPrivate($|/.*)')
        || pathStr.matches(comp + 'judgesPrivate($|/.*)')
        || pathStr.matches(comp + 'assignments($|/.*)')
        || pathStr.matches(comp + 'messages($|/.*)')
        || pathStr.matches(comp + 'documents($|/.*)')
        || pathStr.matches(comp + 'admins($|/.*)')
        // Volunteers' contact details (phone, email, emergency contact)
        || pathStr.matches(comp + 'volunteerSignups($|/.*)')
        // Recalculation log (who ran it)
        || pathStr.matches(comp + 'maintenanceRuns($|/.*)')
        // Horse temperatures (health data): driver, officials and admins only
        || pathStr.matches(comp + 'horseTemperatures($|/.*)')
        // The vet's clinical findings (vet, admins, the driver) and notes (vet, admins)
        || pathStr.matches(comp + 'vetInspections($|/.*)')
        || pathStr.matches(comp + 'vetNotes($|/.*)');
    }

    // The vet's result for one phase on the public equipage (when changed):
    // { status, updatedAt, horses: { [horseKey]: { status, checkedAt } } }.
    // The clinical findings belong in vetInspections, not here.
    function isVetPhaseResultUpdate(field) {
      let after = request.resource.data;
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([field])
        || !(field in after)
        || (after[field] is map
          && after[field].keys().hasOnly(['status', 'updatedAt', 'horses'])
          && after[field].get('horses', {}) is map
          && after[field].get('horses', {}).size() <= 12);
    }

    function isVetEquipageUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return affected.hasOnly(['status', 'vetInspection_initial', 'vetInspection_harness',
          'vetInspection_restArea', 'vetInspection_final', 'vetUnfitStageB', 'lastUpdated', 'updatedAt'])
        // The status the vet gives in the first inspection, nothing else
        && (!affected.hasAny(['status'])
          || request.resource.data.status in ['anmäld', 'incheckad', 'besiktigad', 'ombesiktning', 'struken'])
        && (!affected.hasAny(['vetUnfitStageB']) || request.resource.data.vetUnfitStageB is bool)
        && isVetPhaseResultUpdate('vetInspection_initial')
        && isVetPhaseResultUpdate('vetInspection_harness')
        && isVetPhaseResultUpdate('vetInspection_restArea')
        && isVetPhaseResultUpdate('vetInspection_final');
    }

    // The driver's own temperature entries: only the temperature map (one
    // entry per horse, at most 12) and its timestamp
    function isDriverTemperatureData(data) {
      return (!('horseTemperatures' in data)
          || (data.horseTemperatures is map && data.horseTemperatures.size() <= 12))
        && (!('updatedAt' in data) || data.updatedAt is timestamp || data.updatedAt is string);
    }

    function hasPublicAudience(data) {
      let audience = data.get('audience', {});
      return audience is map && audience.get('public', false) == true;
    }

    function isLegacyPublicMessage(data) {
      return !data.keys().hasAny(['audience'])
        && data.get('targetStartNumber', '') == ''
        && data.get('targetStartNumbers', []).size() == 0;
    }

    function isLegacyPublicDocument(data) {
      return !data.keys().hasAny(['audience']);
    }

    // Driver-only items: not for any signed-in account (anyone can register
    // one). Drivers get theirs from the getDriverInbox function, which matches
    // their verified email to the competition's equipages
    function canReadAudienceScopedItem(data, legacyPublic, appId, compId) {
      return hasPublicAudience(data)
        || legacyPublic
        || (request.auth != null && canAdminThisArtifactsComp(appId, compId));
    }

    // ------------------------------------------------------------------------
    //  DRESSYR / PRECISION / MARATON – FINALISERING (top-level /competitions)
    // ------------------------------------------------------------------------

    // ------------------------------------------------------------------------
    //  ROOT COMPETITIONS (Huvudtävling)
    // ------------------------------------------------------------------------
    match /competitions/{compId} {
      allow read: if true;
      allow write: if request.auth != null
        && (
          isSuperAdmin() ||
          getUserRole() == 'admin' ||
          // Fallback: om du har 'admins' i själva tävlingsdokumentet
          (resource.data.admins != null && request.auth.uid in resource.data.admins) ||
          (resource.data.ownerId == request.auth.uid)
        );
    }

    // competitions/{compId}/dressageFinalization/{startNo}
    match /competitions/{compId}/dressageFinalization/{startNo} {
      allow read: if true;
      allow create, update: if canFinalizeCompetition(compId, 'dressage')
        && isLoggedLockChange(compId, 'dressage', startNo);
      allow delete: if isSuperAdmin();
    }

    // competitions/{compId}/precisionFinalization/{startNo}
    match /competitions/{compId}/precisionFinalization/{startNo} {
      allow read: if true;
      allow create, update: if canFinalizeCompetition(compId, 'precision')
        && isLoggedLockChange(compId, 'precision', startNo);
      allow delete: if isSuperAdmin();
    }

    // competitions/{compId}/marathonFinalization/{startNo}
    match /competitions/{compId}/marathonFinalization/{startNo} {
      allow read: if true;
      allow create, update: if canFinalizeCompetition(compId, 'marathon')
        && isLoggedLockChange(compId, 'marathon', startNo);
      allow delete: if isSuperAdmin();
    }

    // Who finalized or unlocked which result and when. Written in the same
    // batch as the lock; entries are never changed or removed, and only the
    // competition's admins read them (the lock documents above are public).
    match /competitions/{compId}/finalizationLog/{entryId} {
      allow read: if request.auth != null && (isSuperAdmin()
        || canAdminThisArtifactsComp('drivelive', compId)
        || canAdminThisArtifactsComp('combined-driving', compId));
      allow create: if request.resource.data.discipline in ['dressage', 'marathon', 'precision']
        && request.resource.data.action in ['finalize', 'unfinalize']
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.startNumber is string
        && request.resource.data.keys().hasOnly(['discipline', 'action', 'startNumber', 'by', 'byName', 'at', 'reason'])
        // An optional reason for the change (e.g. why a result was unlocked)
        && (request.resource.data.get('reason', null) == null
          || (request.resource.data.reason is string && request.resource.data.reason.size() <= 500))
        && canFinalizeCompetition(compId, request.resource.data.discipline)
        // Only in the batch that changes the lock and names this entry (an
        // entry on its own would log a change that never happened)
        && isLockNamingLogEntry(compId, request.resource.data.discipline, request.resource.data.startNumber, entryId);
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------------
    //  ARTIFACTS – PUBLIC DATA-TRÄD (LÄSBART FÖR ALLA, SKRIVNING KONTROLLERAD)
    //  artifacts/{appId}/public/**  (publik läsning)
    // ------------------------------------------------------------------------

    match /artifacts/{appId}/public/{document=**} {
      allow read: if !isSensitiveArtifactsPublicPath(document)
        && !string(document).matches('.*data/competitions($|/.*)');
    }

    // {sub} first: a bare {rest=**} also matches zero segments, i.e. the
    // competition document itself
    match /artifacts/{appId}/public/data/competitions/{compId}/{sub}/{rest=**} {
      allow read: if !isSensitiveArtifactsPublicPath(request.path)
        && isCompetitionVisible(appId, compId);
    }

    // Rot för competitions (artifacts)
    
    // GLOBAL CONFIG (e.g. clubLogos) - Only Admins/Superadmins
    match /artifacts/{appId}/public/data/config/{docId} {
      allow read: if true;
      allow write: if request.auth != null && (isSuperAdmin() || getUserRole() == 'admin');
    }

    match /artifacts/{appId}/public/data/competitions/{compId} {
      allow get: if resource == null
        || resource.data.get('published', true) != false
        || canReadCompetitionStaffDocs(appId, compId);
      // Plain field comparisons, which a query can prove with where(): the
      // public lists where published == true (older competitions get the
      // field when a global admin opens the hub)
      allow list: if resource.data.published == true
        || (request.auth != null && (
          isSuperAdmin()
          || getUserRole() == 'admin'
          || resource.data.createdBy == request.auth.uid
          || (resource.data.get('admins', []) != null && request.auth.uid in resource.data.get('admins', []))
          || (resource.data.get('staffUids', []) != null && request.auth.uid in resource.data.get('staffUids', []))
        ));

      // create: admin/superadmin only (since new doc has no owner yet)
      allow create: if request.auth != null
        && (
          isSuperAdmin() ||
          getUserRole() == 'admin'
        );

      // UPDATE: the owners (superadmin, global admin, creator, ownerId) change
      // anything. Other competition admins (admins[], /admins/{uid},
      // roleEmails) change the rest but not who owns or administers it: an
      // admin adding themselves to admins[] could otherwise become owner in a
      // second step and delete the competition. staffUids is kept by the
      // server (joinCompetitionAsOfficial, and removed with the admin doc).
      allow update: if request.auth != null
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['deleting', 'deletingBy', 'deletingAt'])
        && (
          isSuperAdmin() ||
          getUserRole() == 'admin' ||
          (resource.data.get('createdBy', '') == request.auth.uid) ||
          (resource.data.get('ownerId', '') == request.auth.uid) ||
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy', 'ownerId', 'admins', 'staffUids'])
            && (
              (resource.data.get('admins', []) != null && request.auth.uid in resource.data.get('admins', []))
              || canAdminThisArtifactsComp(appId, compId)
            )
          )
        );

      // DELETE
      allow delete: if request.auth != null
        && (
          isSuperAdmin() ||
          getUserRole() == 'admin' ||
          (resource.data.get('createdBy', '') == request.auth.uid)
        );
    }

    // Precision (artifacts-komplettering – äldre regel du hade)
    match /artifacts/{appId}/public/data/competitions/{compId}/precision/{docId} {
      allow read: if isCompetitionVisible(appId, compId);
      // Deleting (the competition) is an admin action, also for finalized results
      allow delete: if request.auth != null && canAdminThisArtifactsComp(appId, compId);
      allow write: if request.auth != null
        && (
          canWriteResultsAs(appId, compId, 'precision')
        )
        && (
          isPrecisionResultUnlocked(compId, docId)
        );
    }

    // ---- Dressyrprotokoll (NY STRUKTUR)
    match /artifacts/{appId}/public/data/competitions/{compId}/dressage/{startNumber}/protocols/{docId} {
      allow read: if isCompetitionVisible(appId, compId);
      // Deleting (the competition) is an admin action, also for finalized results
      allow delete: if request.auth != null && canAdminThisArtifactsComp(appId, compId);
      allow write: if request.auth != null
        && (
          canWriteResultsAs(appId, compId, 'dressage')
        )
        && (
          isDressageResultUnlocked(compId, startNumber)
        );
    }

    // Status och live-data för dressyr
    match /artifacts/{appId}/public/data/competitions/{compId}/dressageStatus/{startNumber} {
      allow read: if isCompetitionVisible(appId, compId);
      // Deleting (the competition) is an admin action, also for finalized results
      allow delete: if request.auth != null && canAdminThisArtifactsComp(appId, compId);
      allow write: if request.auth != null
        && (
          canWriteResultsAs(appId, compId, 'dressage')
        )
        && (
          isDressageResultUnlocked(compId, startNumber)
        );

      match /live/{docId} {
        allow read: if isCompetitionVisible(appId, compId);
        // Deleting (the competition) is an admin action, also for finalized results
        allow delete: if request.auth != null && canAdminThisArtifactsComp(appId, compId);
        allow write: if request.auth != null
          && (
            canWriteResultsAs(appId, compId, 'dressage')
          )
          && (
            isDressageResultUnlocked(compId, startNumber)
          );
      }
    }

    // ---- Dressyrprotokoll (LEGACY-STRUKTUR)
    match /artifacts/{appId}/public/data/competitions/{compId}/dressageResults/{startNumber}/protocols/{docId} {
      allow read: if isCompetitionVisible(appId, compId);
      // Deleting (the competition) is an admin action, also for finalized results
      allow delete: if request.auth != null && canAdminThisArtifactsComp(appId, compId);
      allow write: if request.auth != null
        && (
          canWriteResultsAs(appId, compId, 'dressage')
        )
        && (
          isDressageResultUnlocked(compId, startNumber)
        );
    }

    // Status för dressyr per ekipage
    match /artifacts/{appId}/public/data/competitions/{compId}/dressage/{startNo}/meta/{docId} {
      allow read: if isCompetitionVisible(appId, compId);
      // Deleting (the competition) is an admin action, also for finalized results
      allow delete: if request.auth != null && canAdminThisArtifactsComp(appId, compId);
      allow write: if request.auth != null
        && (
          canWriteResultsAs(appId, compId, 'dressage')
        )
        && (
          isDressageResultUnlocked(compId, startNo)
        );
    }

    // ---- Övriga “public data”-samlingar under en tävling (skriv roller/ägare) ----

    match /artifacts/{appId}/public/data/competitions/{compId}/equipages/{equipageId} {
      allow read: if isCompetitionVisible(appId, compId);
      allow create, delete: if request.auth != null
        && (
          isSuperAdmin() ||
          getUserRole() == 'admin' ||
          canAdminThisArtifactsComp(appId, compId)
        );
      allow update: if request.auth != null
        && (
          canAdminThisArtifactsComp(appId, compId) ||
          (
            // The speaker keeps notes for the commentary, nothing else
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['speakerNotes', 'lastUpdated', 'updatedAt'])
            && hasExplicitRoleInComp(appId, compId, 'speaker')
          ) ||
          (
            // The vet: each phase's result and the status from the first
            // inspection (isVetEquipageUpdate). The clinical findings and
            // notes are private (vetInspections, vetNotes)
            isVetEquipageUpdate()
            && isCompetitionOpen(appId, compId)
            && hasExplicitRoleInComp(appId, compId, 'vet')
          ) ||
          (
            // Precision officials measure the carriages (vagnbredd page): the
            // widths decide the cone width, and the safety check with them
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(
              ['trackWidth', 'marathonTrackWidth', 'safetyCheck', 'lastUpdated', 'updatedAt'])
            && isCompetitionOpen(appId, compId)
            && hasExplicitRoleInComp(appId, compId, 'precision')
          ) ||
          (
             // Drivers: notes for the speaker. The declaration (groom,
             // carriage, club, horses) is saved by the updateEquipageDeclaration
             // function, which checks the lock before the start, the lengths,
             // and keeps the vet's data on the horses. Temperatures are not
             // public and live in horseTemperatures/{equipageId} (below)
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(
               ['speakerNotes', 'lastUpdated', 'updatedAt']
             )
             && (!('speakerNotes' in request.resource.data)
               || (request.resource.data.speakerNotes is string && request.resource.data.speakerNotes.size() <= 2000))
             && isCompetitionOpen(appId, compId)
             && canSelfServiceEquipage(appId, compId, equipageId)
          )
        );
    }

    // Horse temperatures (doc id = start number, as equipages): health data,
    // so not public. The competition's officials read them (hasStaffRoleInComp,
    // the vet included), the driver reads and enters their own.
    // Admins enter them for the driver (portal admin mode); the driver only
    // while the competition is not archived (manualLockdown does not stop them:
    // temperatures are taken during the competition)
    // The cheap checks come first: canReadCompetitionStaffDocs asks each role
    // in turn and, with the public-path rules above, runs past the rules'
    // limit of 1000 evaluated expressions per request.
    match /artifacts/{appId}/public/data/competitions/{compId}/horseTemperatures/{equipageId} {
      allow read: if request.auth != null
        && (
          canSelfServiceEquipage(appId, compId, equipageId)
          || hasStaffRoleInComp(appId, compId)
          || canAdminThisArtifactsComp(appId, compId)
        );
      allow create: if request.auth != null
        && (
          (
            canSelfServiceEquipage(appId, compId, equipageId)
            && request.resource.data.keys().hasOnly(['horseTemperatures', 'updatedAt'])
            && isDriverTemperatureData(request.resource.data)
            && isCompetitionOpen(appId, compId)
          )
          || canAdminThisArtifactsComp(appId, compId)
        );
      allow update: if request.auth != null
        && (
          (
            canSelfServiceEquipage(appId, compId, equipageId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['horseTemperatures', 'updatedAt'])
            && isDriverTemperatureData(request.resource.data)
            && isCompetitionOpen(appId, compId)
          )
          || canAdminThisArtifactsComp(appId, compId)
        );
      allow delete: if request.auth != null && canAdminThisArtifactsComp(appId, compId);
    }

    // The vet's clinical findings per equipage (doc id = start number):
    // { horses: { [horseKey]: { [phase]: { pulseBpm, respiration, mucosa,
    // bitOk, harnessOk, checkedAt } } }, updatedAt }. Health data: the vet and
    // admins read and write it, the driver reads their own (verified email on
    // equipagePrivate, as horseTemperatures). Other officials and the public
    // see only the result on the equipage (vetInspection_<phase>).
    match /artifacts/{appId}/public/data/competitions/{compId}/vetInspections/{equipageId} {
      allow read: if request.auth != null
        && (
          canSelfServiceEquipage(appId, compId, equipageId)
          || hasExplicitRoleInComp(appId, compId, 'vet')
          || canAdminThisArtifactsComp(appId, compId)
        );
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['horses', 'updatedAt'])
        && request.resource.data.get('horses', {}) is map
        && request.resource.data.get('horses', {}).size() <= 12
        && (
          (hasExplicitRoleInComp(appId, compId, 'vet') && isCompetitionOpen(appId, compId))
          || canAdminThisArtifactsComp(appId, compId)
        );
      allow delete: if request.auth != null && canAdminThisArtifactsComp(appId, compId);
    }

    // The vet's own notes per equipage and phase: the vet and admins only
    // (not the driver, not other officials)
    match /artifacts/{appId}/public/data/competitions/{compId}/vetNotes/{equipageId} {
      allow read: if request.auth != null
        && (
          hasExplicitRoleInComp(appId, compId, 'vet')
          || canAdminThisArtifactsComp(appId, compId)
        );
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['notes', 'updatedAt'])
        && request.resource.data.get('notes', {}) is map
        && request.resource.data.get('notes', {}).keys().hasOnly(['initial', 'harness', 'restArea', 'final'])
        && (
          (hasExplicitRoleInComp(appId, compId, 'vet') && isCompetitionOpen(appId, compId))
          || canAdminThisArtifactsComp(appId, compId)
        );
      allow delete: if request.auth != null && canAdminThisArtifactsComp(appId, compId);
    }

    match /artifacts/{appId}/public/data/competitions/{compId}/equipagePrivate/{equipageId} {
      allow read: if request.auth != null
        && (
          canAdminThisArtifactsComp(appId, compId) ||
          (
            hasVerifiedEmail() &&
            request.auth.token.email.lower() == resource.data.get('email', '').lower()
          )
        );
      allow create, update, delete: if request.auth != null
        && canAdminThisArtifactsComp(appId, compId);
    }

    match /artifacts/{appId}/public/data/competitions/{compId}/roleEmails/{emailId} {
      allow read: if request.auth != null
        && (
          (hasVerifiedEmail() && request.auth.token.email.lower() == emailId) ||
          canAdminThisArtifactsComp(appId, compId)
        );
      allow create, update, delete: if request.auth != null
        && canAdminThisArtifactsComp(appId, compId);
    }

    // Teams Management
    match /artifacts/{appId}/public/data/competitions/{compId}/teams/{teamId} {
      allow read: if isCompetitionVisible(appId, compId);
      allow create, update, delete: if request.auth != null
        && (
          isSuperAdmin() ||
          getUserRole() == 'admin' ||
          canAdminThisArtifactsComp(appId, compId)
        );
    }

    match /artifacts/{appId}/public/data/competitions/{compId}/judges/{judgeId} {
      allow read: if canReadCompetitionStaffDocs(appId, compId);
      allow write, delete: if request.auth != null
        && (
          isSuperAdmin() ||
          getUserRole() == 'admin' ||
          canAdminThisArtifactsComp(appId, compId)
        );
    }

    match /artifacts/{appId}/public/data/competitions/{compId}/officials/{officialId} {
      allow read: if canReadCompetitionStaffDocs(appId, compId);
      allow write, delete: if request.auth != null
        && (
          isSuperAdmin() ||
          getUserRole() == 'admin' ||
          canAdminThisArtifactsComp(appId, compId)
        );
    }

    // Officials' contact details (phone, email, emergency contact, diet, notes):
    // admins, and each official their own (matched on the verified email)
    match /artifacts/{appId}/public/data/competitions/{compId}/officialsPrivate/{officialId} {
      allow read: if request.auth != null
        && (
          canAdminThisArtifactsComp(appId, compId) ||
          (hasVerifiedEmail() && resource.data.get('email', '') == request.auth.token.email.lower())
        );
      allow write, delete: if request.auth != null
        && canAdminThisArtifactsComp(appId, compId);
    }

    // Judges' contact details and licence: as for officials
    match /artifacts/{appId}/public/data/competitions/{compId}/judgesPrivate/{judgeId} {
      allow read: if request.auth != null
        && (
          canAdminThisArtifactsComp(appId, compId) ||
          (hasVerifiedEmail() && resource.data.get('email', '') == request.auth.token.email.lower())
        );
      allow write, delete: if request.auth != null
        && canAdminThisArtifactsComp(appId, compId);
    }

    match /artifacts/{appId}/public/data/competitions/{compId}/assignments/{assignmentId} {
      allow read: if canReadCompetitionStaffDocs(appId, compId);
      allow write, delete: if request.auth != null
        && (
          isSuperAdmin() ||
          getUserRole() == 'admin' ||
          canAdminThisArtifactsComp(appId, compId)
        );
    }

    // Volunteer Signups (Callable-only create, Admin read/delete)
    match /artifacts/{appId}/public/data/competitions/{compId}/volunteerSignups/{docId} {
      allow create: if false;
      allow update: if false;
      allow read, delete: if request.auth != null
        && (
          isSuperAdmin() ||
          getUserRole() == 'admin' ||
          canAdminThisArtifactsComp(appId, compId)
        );
    }

    match /artifacts/{appId}/public/data/competitions/{compId}/config/{configId} {
      // get only: a list query on config would include config/secrets. Admins
      // (who may read the secrets anyway) list it, e.g. to delete a competition
      allow get: if configId != 'secrets' && isCompetitionVisible(appId, compId);
      allow list: if request.auth != null && canAdminThisArtifactsComp(appId, compId);
      allow write, delete: if configId != 'globalStatus' && configId != 'secrets'
        && request.auth != null
        && canAdminThisArtifactsComp(appId, compId);
    }

    // Global pause and marathon status: marathon officials (observer, stage
    // input) record pauses here, and the pause log is subtracted from stage times
    match /artifacts/{appId}/public/data/competitions/{compId}/config/globalStatus {
      allow write: if request.auth != null
        && canWriteResultsAs(appId, compId, 'marathon')
        && (canAdminThisArtifactsComp(appId, compId) || isPauseLogAppendOrClose());
    }

    // Hemliga konfigurationer (t.ex. PIN-kod)
    match /artifacts/{appId}/public/data/competitions/{compId}/config/secrets {
      allow read, write: if request.auth != null
        && (
          canAdminThisArtifactsComp(appId, compId)
        );
    }

    // Administratörer som joinat med PIN-kod
    match /artifacts/{appId}/public/data/competitions/{compId}/admins/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || canAdminThisArtifactsComp(appId, compId));
      allow create, update: if false;
      allow delete: if request.auth != null && canAdminThisArtifactsComp(appId, compId);
    }

    // Collection-group discovery so officials can find draft competitions in Hub
    match /{path=**}/roleEmails/{emailId} {
      allow read: if request.auth != null
        && hasVerifiedEmail()
        && request.auth.token.email.lower() == resource.data.get('email', '').lower();
    }

    match /{path=**}/admins/{userId} {
      allow read: if request.auth != null
        && (
          request.auth.uid == userId ||
          request.auth.uid == resource.data.get('uid', '') ||
          (hasVerifiedEmail() && request.auth.token.email.lower() == resource.data.get('email', '').lower())
        );
    }

    // NYTT: Meddelanden (Messages)
    match /artifacts/{appId}/public/data/competitions/{compId}/messages/{msgId} {
      allow get: if isCompetitionVisible(appId, compId)
        && canReadAudienceScopedItem(resource.data, isLegacyPublicMessage(resource.data), appId, compId);
      allow list: if (hasPublicAudience(resource.data) && isCompetitionVisible(appId, compId))
        || (request.auth != null && canAdminThisArtifactsComp(appId, compId));
      allow write, delete: if request.auth != null
        && (
          isSuperAdmin() ||
          getUserRole() == 'admin' ||
          canAdminThisArtifactsComp(appId, compId)
        );
    }

    // NYTT: Dokument (Documents)
    match /artifacts/{appId}/public/data/competitions/{compId}/documents/{docId} {
      allow get: if isCompetitionVisible(appId, compId)
        && canReadAudienceScopedItem(resource.data, isLegacyPublicDocument(resource.data), appId, compId);
      allow list: if (hasPublicAudience(resource.data) && isCompetitionVisible(appId, compId))
        || (request.auth != null && canAdminThisArtifactsComp(appId, compId));
      allow write, delete: if request.auth != null
        && (
          isSuperAdmin() ||
          getUserRole() == 'admin' ||
          canAdminThisArtifactsComp(appId, compId)
        );
    }

    match /artifacts/{appId}/public/data/competitions/{compId}/auditLog/{docId} {
      allow read, write: if false;
    }

    match /artifacts/{appId}/private/data/competitions/{compId}/auditLog/{docId} {
      allow read: if request.auth != null
        && (
          isSuperAdmin() ||
          getUserRole() == 'admin' ||
          canAdminThisArtifactsComp(appId, compId)
        );
      allow create: if request.auth != null
        && (
          isSuperAdmin() ||
          getUserRole() == 'admin' ||
          canAdminThisArtifactsComp(appId, compId)
        );
      allow update, delete: if false;
    }

    // ---- SAMMANSTÄLLDA RESULTAT (computed-results)
    // Archive snapshots (finalizeCompetition): the result list as archived.
    // Created by an admin, never changed or removed from the app; deleting the
    // whole competition runs on the server (deleteCompetitionData)
    match /artifacts/{appId}/public/data/competitions/{compId}/archive/{snapshotId} {
      allow read: if isCompetitionVisible(appId, compId);
      allow create: if request.auth != null && canAdminThisArtifactsComp(appId, compId);
      allow update, delete: if false;
    }

    match /artifacts/{appId}/public/data/competitions/{compId}/computed_equipages/{equipId} {
      allow read: if isCompetitionVisible(appId, compId);

      allow write: if false; // Only Server (Cloud Functions) updates this

      allow delete: if request.auth != null
        && (
          isSuperAdmin() ||
          getUserRole() == 'admin' ||
          canAdminThisArtifactsComp(appId, compId)
        );
    }

    // maraton hinder definitioner
    match /artifacts/{appId}/public/data/competitions/{compId}/maratonObstacles/{obstacleId} {
      allow read: if isCompetitionVisible(appId, compId);
      allow write: if request.auth != null
        && (
          canWriteResultsAs(appId, compId, 'marathon')
        );
    }

    match /artifacts/{appId}/public/data/competitions/{compId}/maratonLive/{docId} {
      allow read: if isCompetitionVisible(appId, compId);
      // Deleting (the competition) is an admin action, also for finalized results
      allow delete: if request.auth != null && canAdminThisArtifactsComp(appId, compId);
      allow write: if request.auth != null
        && (
          canWriteResultsAs(appId, compId, 'marathon')
        )
        && (
          isMarathonResultUnlocked(compId, docId)
        );
    }

    match /artifacts/{appId}/public/data/competitions/{compId}/maraton/{resultId} {
      allow read: if isCompetitionVisible(appId, compId);
      // Deleting (the competition) is an admin action, also for finalized results
      allow delete: if request.auth != null && canAdminThisArtifactsComp(appId, compId);
      allow write: if request.auth != null
        && (
          canWriteResultsAs(appId, compId, 'marathon')
        )
        && (
          isMarathonResultUnlocked(compId, resultId)
        );
    }

    match /artifacts/{appId}/public/data/competitions/{compId}/maraton-timing/{equipageId} {
      allow read: if isCompetitionVisible(appId, compId);
      // Deleting (the competition) is an admin action, also for finalized results
      allow delete: if request.auth != null && canAdminThisArtifactsComp(appId, compId);
      allow write: if request.auth != null
        && (
          canWriteResultsAs(appId, compId, 'marathon')
        )
        && (
          isMarathonResultUnlocked(compId, equipageId)
        );
    }

    match /artifacts/{appId}/public/data/competitions/{compId}/maratonResults/{equipageId} {
      allow read: if isCompetitionVisible(appId, compId);
    }

    match /artifacts/{appId}/public/data/competitions/{compId}/maratonResults/{equipageId}/obstacles/{obstacleId} {
      allow read: if isCompetitionVisible(appId, compId);
      // Deleting (the competition) is an admin action, also for finalized results
      allow delete: if request.auth != null && canAdminThisArtifactsComp(appId, compId);
      allow write: if request.auth != null
        && (
          canWriteResultsAs(appId, compId, 'marathon')
        )
        && (
          isMarathonResultUnlocked(compId, equipageId)
        );
    }



    // ------------------------------------------------------------------------
    //  USERS
    // ------------------------------------------------------------------------
    function validSelfUserCreate(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['email', 'role', 'createdAt', 'claimedEquipages'])
        && request.resource.data.get('email', '') == request.auth.token.email
        && request.resource.data.get('role', '') == 'publik'
        && request.resource.data.get('claimedEquipages', []) is list;
    }

    function validSelfUserUpdate(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedEquipages'])
        && request.resource.data.get('claimedEquipages', []) is list;
    }

    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId || 
        isSuperAdmin() || 
        getUserRole() == 'admin'
      );
      allow create: if isSuperAdmin() || validSelfUserCreate(userId);
      allow update: if isSuperAdmin() || validSelfUserUpdate(userId);
      allow delete: if isSuperAdmin();
    }

  }
}
